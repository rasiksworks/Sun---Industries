---
import type { ImageMetadata } from "astro";
import OwnerSlot from "../ui/OwnerSlot.astro";
import RevealImage from "../ui/RevealImage.astro";
import Button from "../ui/Button.astro";

interface Props {
  variant?: "split" | "full";
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  photoLabel?: string;
  photoSrc?: ImageMetadata;
  photoAlt?: string;
}

const {
  variant = "split",
  eyebrow,
  title,
  subtitle,
  ctaLabel = "Book a free site measurement",
  ctaHref = "/get-a-quote",
  photoLabel = "Hero photo",
  photoSrc,
  photoAlt = "",
} = Astro.props as Props;

// "full" variant only: split the title into two lines at the first comma,
// so the first clause anchors left and the second anchors right.
const titleCommaIndex = title.indexOf(",");
const titleLine1 = titleCommaIndex !== -1 ? title.slice(0, titleCommaIndex + 1) : title;
const titleLine2 = titleCommaIndex !== -1 ? title.slice(titleCommaIndex + 1).trim() : "";
---

{
  variant === "full" ? (
    <section class="flex flex-1 flex-col justify-between px-4 pb-10 pt-8 md:px-11 lg:px-20 lg:pb-16 lg:pt-10">
      <div>
        {eyebrow && (
          <p class="text-sm font-semibold uppercase tracking-wide text-sun-text">{eyebrow}</p>
        )}
        <h1 class="font-bold leading-[1.05] text-ink" data-stx-skip>
          <span class="block text-left [font-size:clamp(2.25rem,9vw,3rem)] sm:hidden">{title}</span>
          <span class="hidden sm:block sm:whitespace-nowrap sm:[font-size:clamp(1.75rem,4.8vw,4.5rem)]">
            <span class="block text-left">{titleLine1}</span>
            {titleLine2 && <span class="block text-left sm:text-right">{titleLine2}</span>}
          </span>
        </h1>
      </div>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        {subtitle && (
          <p class="max-w-md font-body text-base text-surface [text-shadow:0_1px_4px_rgba(0,0,0,0.7)] sm:text-lg sm:[text-shadow:none]">
            {subtitle}
          </p>
        )}
        <Button href={ctaHref} class="shrink-0 font-body font-semibold">{ctaLabel}</Button>
      </div>
    </section>
  ) : (
    <section class="grid gap-0 border-b border-haze lg:grid-cols-2">
      <div class="order-2 flex flex-col justify-center gap-5 px-4 md:px-11 lg:px-20 py-12 lg:order-1 lg:py-20">
        <div
          class="grid grid-cols-6 gap-2 opacity-10"
          style="grid-template-rows: repeat(3, 1px);"
          aria-hidden="true"
        >
          {Array.from({ length: 18 }).map(() => (
            <span class="h-px w-full bg-ink" />
          ))}
        </div>
        {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-sun-text">{eyebrow}</p>}
        <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl lg:text-5xl">{title}</h1>
        {subtitle && <p class="max-w-prose font-body text-base text-muted sm:text-lg">{subtitle}</p>}
        <Button href={ctaHref} class="font-body font-semibold">{ctaLabel}</Button>
      </div>
      <div class="order-1 lg:order-2">
        {photoSrc ? (
          <RevealImage
            src={photoSrc}
            alt={photoAlt}
            fit="cover"
            class="min-h-64 w-full lg:min-h-full"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        ) : (
          <OwnerSlot label={photoLabel} class="min-h-64 w-full rounded-none border-x-0 lg:min-h-full" />
        )}
      </div>
    </section>
  )
}
