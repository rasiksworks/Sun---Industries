---
import type { ImageMetadata } from "astro";
import OwnerSlot from "../ui/OwnerSlot.astro";
import RevealImage from "../ui/RevealImage.astro";

interface Props {
  limit?: number;
}

const { limit } = Astro.props as Props;

const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const sorted = Object.entries(galleryImages)
  .map(([path, mod]) => ({ path, image: mod.default }))
  .sort((a, b) => a.path.localeCompare(b.path));

// "Recent work 1" and "Recent work 2" are pinned to the first two column-1
// slots (grid positions 0 and 3, the 3:4 aspect column), everything else
// keeps its existing alphabetical order in the remaining slots.
const pinnedNames = ["Recent work 1", "Recent work 2"];
const pinnedTargetIndices = [0, 3];

const pinned: (typeof sorted)[number][] = [];
const rest: (typeof sorted)[number][] = [];
sorted.forEach((entry) => {
  const filename = entry.path.split("/").pop() ?? "";
  const pinnedIndex = pinnedNames.findIndex((name) => filename.startsWith(name));
  if (pinnedIndex !== -1) pinned[pinnedIndex] = entry;
  else rest.push(entry);
});

const entries: (typeof sorted)[number][] = new Array(sorted.length);
pinnedTargetIndices.forEach((targetIndex, i) => {
  if (pinned[i]) entries[targetIndex] = pinned[i];
});
let restCursor = 0;
for (let i = 0; i < entries.length; i++) {
  if (!entries[i]) entries[i] = rest[restCursor++];
}

const files = limit ? entries.slice(0, limit) : entries;
---

{
  files.length === 0 ? (
    <OwnerSlot label="Gallery photos" class="min-h-56 w-full" />
  ) : (
    <div class="grid gap-4 sm:grid-cols-3">
      {files.map((entry, i) => (
        <RevealImage
          src={entry.image}
          alt="Sun Industries completed work photo"
          class:list={[
            "w-full rounded-lg border border-haze",
            i % 3 === 0 ? "aspect-[3/4]" : "aspect-square",
          ]}
          sizes="(min-width: 640px) 33vw, 100vw"
        />
      ))}
    </div>
  )
}
