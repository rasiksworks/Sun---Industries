---
import Button from "../ui/Button.astro";
---

<div data-ws-reveal>
  <section class="ws-clip flex min-h-screen flex-col items-center justify-center bg-ink px-4 py-20 text-center text-surface md:px-11 lg:px-20">
    <h2 class="max-w-3xl text-3xl font-medium text-surface/70 sm:text-4xl">
      One workshop. Twenty years. Every frame we build.
    </h2>
    <p class="mt-4 font-body text-sm text-surface/50">Nagercoil, Kanyakumari District.</p>
    <Button href="/get-a-quote" class="mt-10 text-sm uppercase tracking-wide">Get a free quote</Button>
  </section>
</div>

<style>
  /* Grows from a thin band centered in the viewport out to full height,
     the first time this section scrolls into view. One-shot. */
  .ws-clip {
    clip-path: inset(50% 0 50% 0);
    transition: clip-path 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ws-clip.ws-active {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .ws-clip {
      clip-path: none;
      transition: none;
    }
  }
</style>

<script>
  function init() {
    const items = document.querySelectorAll<HTMLElement>("[data-ws-reveal]:not([data-ws-bound])");
    if (!items.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((el) => el.setAttribute("data-ws-bound", "true"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.querySelector(".ws-clip")?.classList.add("ws-active");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    items.forEach((el) => {
      el.setAttribute("data-ws-bound", "true");
      observer.observe(el);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
