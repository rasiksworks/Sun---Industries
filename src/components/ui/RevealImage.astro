---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  widths?: number[];
  sizes?: string;
  fit?: "cover" | "auto";
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  widths = [320, 480, 640, 960],
  sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  fit = "cover",
} = Astro.props as Props;
---

<span class:list={["reveal-wrap block overflow-hidden", className]} data-reveal>
  <Image
    src={src}
    alt={alt}
    loading={loading}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality="mid"
    class:list={[
      "reveal-image block w-full",
      fit === "cover" ? "h-full object-cover" : "h-auto",
    ]}
  />
</span>

<style>
  /* The wrapper (observed by IntersectionObserver) is never clipped, so
     it always reports its real geometry. Only the inner image is
     clip-path-animated, wiping in from top to bottom the first time the
     wrapper scrolls into view. One-shot: once revealed, it stays. */
  .reveal-image {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal-wrap.reveal-active .reveal-image {
    clip-path: inset(0 0 0% 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-image {
      clip-path: none;
      transition: none;
    }
  }
</style>

<script>
  function init() {
    const items = document.querySelectorAll<HTMLElement>("[data-reveal]:not([data-reveal-bound])");
    if (!items.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((el) => el.setAttribute("data-reveal-bound", "true"));
      return;
    }

    function revealWhenReady(wrap: HTMLElement) {
      const img = wrap.querySelector("img");
      if (!img || img.complete) {
        wrap.classList.add("reveal-active");
        return;
      }
      const reveal = () => wrap.classList.add("reveal-active");
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
    }

    // Two separate observers, deliberately not merged: preloading early
    // avoids a blank-image flash, but the wipe-in should only play once the
    // image is actually reaching the viewport, not ~40% of a screen early.

    // Fires ~40% of a screen height before the image actually enters the
    // viewport, overriding native lazy-loading's own, more conservative
    // distance, so the fetch is already done by the time it's reached.
    const preloadObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const img = entry.target.querySelector("img");
          if (img) img.loading = "eager";
          preloadObserver.unobserve(entry.target);
        });
      },
      { threshold: 0, rootMargin: "300px 0px 300px 0px" },
    );

    // Plays the clip-path wipe only once the image is fully inside the
    // viewport (threshold 1), not as soon as its edge first appears, so
    // the user is looking at the whole image before it starts revealing.
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealWhenReady(entry.target as HTMLElement);
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 1 },
    );

    items.forEach((el) => {
      el.setAttribute("data-reveal-bound", "true");
      preloadObserver.observe(el);
      revealObserver.observe(el);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
