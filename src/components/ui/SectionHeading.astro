---
import PillBadge from "./PillBadge.astro";

interface Props {
  pill: string;
  title: string;
  class?: string;
}

const { pill, title, class: className = "" } = Astro.props as Props;
---

<div class:list={["mb-6", className]}>
  <PillBadge label={pill} />
  <h2 class="mt-3 text-2xl font-bold text-ink sm:text-3xl">{title}</h2>
</div>
