---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props as Props;

const REPEATS = 3;
const chars = Array.from(number);
---

<div class="rounded-lg border border-haze bg-haze/30 px-6 py-10 text-center" data-stat-card>
  <p class="stat-number text-ink">
    {
      chars.map((ch, i) => {
        const digit = /[0-9]/.test(ch) ? Number(ch) : null;
        if (digit !== null) {
          const targetRow = REPEATS * 10 - 10 + digit;
          return (
            <span class="spin-char">
              <span class="spin-track" style={`--target-row:${targetRow};transition-delay:${i * 70}ms`}>
                {Array.from({ length: REPEATS }).flatMap(() =>
                  Array.from({ length: 10 }).map((_, d) => <span>{d}</span>),
                )}
              </span>
            </span>
          );
        }
        return (
          <span class="spin-letter" style={`transition-delay:${i * 70}ms`}>
            {ch === " " ? " " : ch}
          </span>
        );
      })
    }
  </p>
  <p class="mt-3 text-sm text-muted">{label}</p>
</div>

<style>
  .spin-char {
    display: inline-block;
    overflow: hidden;
    height: 1em;
    line-height: 1;
    vertical-align: bottom;
  }

  .spin-track {
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .spin-track > span {
    display: block;
    height: 1em;
    line-height: 1;
  }

  [data-stat-active] .spin-track {
    transform: translateY(calc(var(--target-row) * -1em));
  }

  .spin-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  [data-stat-active] .spin-letter {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .spin-track,
    .spin-letter {
      transition: none !important;
    }
  }
</style>

<script>
  function init() {
    const cards = document.querySelectorAll<HTMLElement>("[data-stat-card]:not([data-stat-bound])");
    if (!cards.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cards.forEach((el) => {
        el.setAttribute("data-stat-bound", "true");
        el.setAttribute("data-stat-active", "true");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute("data-stat-active", "true");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );

    cards.forEach((el) => {
      el.setAttribute("data-stat-bound", "true");
      observer.observe(el);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
