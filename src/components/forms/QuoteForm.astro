---
---

<form id="quote-form" class="flex max-w-xl flex-col gap-5" novalidate>
  <div class="flex flex-col gap-1.5">
    <label for="name" class="text-sm font-medium text-ink">Name</label>
    <input
      id="name"
      name="name"
      type="text"
      required
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="phone" class="text-sm font-medium text-ink">Phone number</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      required
      pattern="[0-9+ ]{10,15}"
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="location" class="text-sm font-medium text-ink">Location (village or town)</label>
    <input
      id="location"
      name="location"
      type="text"
      required
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="need" class="text-sm font-medium text-ink">What do you need</label>
    <select
      id="need"
      name="need"
      required
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    >
      <option value="">Select an option</option>
      <option value="upvc">uPVC windows</option>
      <option value="steel">Steel doors</option>
      <option value="clamps">Clamps (wholesale)</option>
      <option value="laser-cutting">Laser cutting</option>
      <option value="not-sure">Not sure</option>
    </select>
  </div>

  <div id="openings-field" class="flex flex-col gap-1.5">
    <label for="openings" class="text-sm font-medium text-ink">Roughly how many openings</label>
    <input
      id="openings"
      name="openings"
      type="number"
      min="1"
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="floor" class="text-sm font-medium text-ink">Which floor</label>
    <select
      id="floor"
      name="floor"
      required
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    >
      <option value="">Select an option</option>
      <option value="ground">Ground</option>
      <option value="first">First</option>
      <option value="above">Above</option>
    </select>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="timeline" class="text-sm font-medium text-ink">When do you need it</label>
    <select
      id="timeline"
      name="timeline"
      required
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    >
      <option value="">Select an option</option>
      <option value="this-month">This month</option>
      <option value="1-3-months">1–3 months</option>
      <option value="just-planning">Just planning</option>
    </select>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="photo" class="text-sm font-medium text-ink">Photo of the opening (optional)</label>
    <input id="photo" name="photo" type="file" accept="image/*" class="text-sm" />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="notes" class="text-sm font-medium text-ink">Anything else</label>
    <textarea
      id="notes"
      name="notes"
      rows="3"
      class="rounded-md border border-haze px-3 py-2 text-sm focus:border-sun-text focus:outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="btn-radial rounded-md bg-sun px-6 py-3 font-semibold text-ink"
    style="--btn-radial-color: var(--color-sun-deep)"
  >
    <span class="btn-radial-fill"></span>
    <span class="btn-radial-label">Submit</span>
  </button>

  <p id="quote-success" class="hidden rounded-md bg-haze px-4 py-3 text-sm text-ink" role="status">
    Thanks, we've received your details and will get back to you shortly.
  </p>
</form>

<script>
  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const needField = document.getElementById("need") as HTMLSelectElement | null;
  const openingsField = document.getElementById("openings-field");
  const success = document.getElementById("quote-success");

  const syncOpeningsVisibility = () => {
    const hideFor = ["clamps", "laser-cutting"];
    const shouldHide = needField ? hideFor.includes(needField.value) : false;
    openingsField?.classList.toggle("hidden", shouldHide);
  };

  needField?.addEventListener("change", syncOpeningsVisibility);
  syncOpeningsVisibility();

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    form.classList.add("hidden");
    success?.classList.remove("hidden");
  });
</script>
