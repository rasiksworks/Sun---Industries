<script>
  // Progressively reveals every h1/h2 on the page, word by word, as it
  // scrolls through the viewport. Non-destructive: it wraps existing text
  // nodes in <span class="stx-word"> without touching element children,
  // so headings built from multiple colored/blocked spans (e.g. two-tone
  // headlines) keep their existing structure and colors intact.

  function wrapWords(node: Node) {
    Array.from(node.childNodes).forEach((child) => {
      if (child.nodeType === Node.TEXT_NODE) {
        const text = child.textContent ?? "";
        if (!text.trim()) return;
        const frag = document.createDocumentFragment();
        text.split(/(\s+)/).forEach((part) => {
          if (part.trim() === "") {
            frag.appendChild(document.createTextNode(part));
          } else {
            const span = document.createElement("span");
            span.className = "stx-word";
            span.textContent = part;
            frag.appendChild(span);
          }
        });
        node.replaceChild(frag, child);
      } else if (child.nodeType === Node.ELEMENT_NODE) {
        wrapWords(child);
      }
    });
  }

  function init() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const items: { el: HTMLElement; words: HTMLElement[] }[] = [];

    document.querySelectorAll<HTMLElement>("h1:not([data-stx-skip]), h2:not([data-stx-skip])").forEach((heading) => {
      if (heading.dataset.stxDone) return;
      heading.dataset.stxDone = "true";
      wrapWords(heading);
      heading.classList.add("stx-ready");
      const words = Array.from(heading.querySelectorAll<HTMLElement>(".stx-word"));
      if (words.length) items.push({ el: heading, words });
    });

    if (!items.length) return;

    let ticking = false;

    function update() {
      const vh = window.innerHeight;
      const start = vh * 0.9;
      const end = vh * 0.4;

      items.forEach(({ el, words }) => {
        const rect = el.getBoundingClientRect();
        const span = start - end + rect.height * 0.6;
        const progress = Math.min(1, Math.max(0, (start - rect.top) / span));
        const activeCount = Math.round(progress * words.length);
        words.forEach((word, i) => {
          word.classList.toggle("stx-active", i < activeCount);
        });
      });

      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
