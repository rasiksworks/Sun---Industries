---
import { getEntry } from "astro:content";
import {
  LayoutGrid,
  Layers,
  ClipboardList,
  IndianRupee,
  Ruler,
  ShieldCheck,
  BadgeCheck,
  Clock,
  MessageCircleQuestionMark,
  Check,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import SpecTable from "../components/ui/SpecTable.astro";
import Placeholder from "../components/ui/Placeholder.astro";
import FaqAccordion from "../components/sections/FaqAccordion.astro";

const upvc = await getEntry("specsUpvc", "upvc");
const whyChooseUs = await getEntry("whyChooseUs", "why-choose-us");
const {
  ratePerSqFt,
  reinforcementThicknessMm,
  gasketMaterial,
  profileBrand,
  frameWarrantyYears,
  hardwareWarrantyYears,
  turnaroundDays,
  productTypes,
  glassOptions,
} = upvc!.data;
---

<BaseLayout
  title="uPVC Windows & Doors"
  description={`uPVC windows and doors from Sun Industries: ₹${ratePerSqFt}/sq ft, ${gasketMaterial} gaskets, ${frameWarrantyYears}-year frame warranty, ${turnaroundDays}-day turnaround.`}
>
  <Hero
    eyebrow="uPVC Windows & Doors"
    title="uPVC windows & doors"
    subtitle={`₹${ratePerSqFt} per sq. ft., ${turnaroundDays}-day turnaround.`}
    photoLabel="uPVC product photo"
  />

  <section class="px-4 md:px-11 lg:px-20 py-12">
    <div class="mb-6 flex items-center gap-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-haze/60 text-ink">
        <LayoutGrid class="size-4" aria-hidden="true" />
      </span>
      <h2 class="text-2xl font-bold text-ink">Product types</h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        productTypes.map((type) => (
          <div class="flex items-center gap-2.5 rounded-md border border-haze px-4 py-3 text-sm text-ink">
            <Check class="size-4 shrink-0 text-sun-text" aria-hidden="true" />
            {type}
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-haze/30 px-4 md:px-11 lg:px-20 py-12">
    <div class="mb-6 flex items-center gap-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-surface text-ink">
        <Layers class="size-4" aria-hidden="true" />
      </span>
      <h2 class="text-2xl font-bold text-ink">Glass options</h2>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        glassOptions.map((option) => (
          <span class="rounded-full border border-haze bg-surface px-3 py-1 text-sm text-ink">{option}</span>
        ))
      }
    </div>
  </section>

  <section class="px-4 md:px-11 lg:px-20 py-12">
    <div class="mb-6 flex items-center gap-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-haze/60 text-ink">
        <ClipboardList class="size-4" aria-hidden="true" />
      </span>
      <h2 class="text-2xl font-bold text-ink">Specifications</h2>
    </div>
    <SpecTable
      rows={[
        { label: "Rate", value: `₹${ratePerSqFt} / sq ft`, status: "verified", icon: IndianRupee },
        { label: "Reinforcement thickness", value: `${reinforcementThicknessMm} mm`, status: "verified", icon: Ruler },
        { label: "Gasket material", value: gasketMaterial, status: "verified", icon: Layers },
        { label: "Profile brand", value: profileBrand, status: "confirm", icon: BadgeCheck },
        { label: "Frame warranty", value: `${frameWarrantyYears} years`, status: "verified", icon: ShieldCheck },
        { label: "Hardware warranty", value: `${hardwareWarrantyYears} year`, status: "verified", icon: ShieldCheck },
        { label: "Turnaround", value: `${turnaroundDays} days`, status: "verified", icon: Clock },
      ]}
    />
    <p class="mt-3 text-xs text-muted">
      Confirm <Placeholder value={null} label="Written warranty terms" /> before this is used as a headline claim.
    </p>
  </section>

  <section class="bg-haze/30 px-4 md:px-11 lg:px-20 py-12">
    <div class="flex gap-4 rounded-lg border border-haze bg-surface px-6 py-6">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-haze/60 text-ink">
        <MessageCircleQuestionMark class="size-4" aria-hidden="true" />
      </span>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-muted">The #1 question we get on the phone</p>
        <p class="mt-2 text-ink">{whyChooseUs!.data.topPhoneQuestion}</p>
        <p class="mt-2 text-sm text-muted">
          That's why every spec on this page (profile, gasket, warranty, turnaround) is published up front.
        </p>
      </div>
    </div>
  </section>

  <FaqAccordion />

</BaseLayout>
