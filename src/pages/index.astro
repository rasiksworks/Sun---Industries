---
import type { ImageMetadata } from "astro";
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import RateStrip from "../components/ui/RateStrip.astro";
import DoorCard from "../components/ui/DoorCard.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import StatCard from "../components/ui/StatCard.astro";
import WorkStrip from "../components/sections/WorkStrip.astro";
import HowItWorksSteps from "../components/sections/HowItWorksSteps.astro";
import GalleryGrid from "../components/sections/GalleryGrid.astro";
import PillBadge from "../components/ui/PillBadge.astro";
import Button from "../components/ui/Button.astro";
import ReviewBadge from "../components/ui/ReviewBadge.astro";
import TestimonialCard from "../components/ui/TestimonialCard.astro";

// DEMO PLACEHOLDER testimonials for today's client demo. Not real customer
// quotes, swap for actual reviews before this site goes live.
const demoTestimonials = [
  {
    quote:
      "They explained exactly what steel and gasket they were using before we paid anything. No surprises, the frame arrived exactly as quoted.",
    name: "Ravi K.",
    location: "Nagercoil",
  },
  {
    quote: "Fast installation and the windows have held up well through two monsoons.",
    name: "Meena S.",
    location: "Kanyakumari",
  },
  {
    quote: "Ordered clamps in bulk for our workshop, good quality and fair pricing.",
    name: "Suresh P.",
    location: "Nagercoil",
  },
  {
    quote: "Needed grills for our balcony on short notice, they fit perfectly the first time.",
    name: "Lakshmi N.",
    location: "Nagercoil",
  },
  {
    quote: "Sent a drawing for a laser-cut bracket and got it back cut to spec within the week.",
    name: "Anand V.",
    location: "Kanyakumari",
  },
  {
    quote: "Straightforward pricing, no pressure to upgrade to something we didn't need.",
    name: "Devi R.",
    location: "Nagercoil",
  },
  {
    quote: "Replaced every window in the house over two weekends, minimal mess left behind.",
    name: "Joseph M.",
    location: "Nagercoil",
  },
];

const business = await getEntry("business", "business");
const upvc = await getEntry("specsUpvc", "upvc");
const serviceArea = await getEntry("serviceArea", "service-area");

const { googleRating, googleReviewCount, foundedYear } = business!.data;
const {
  ratePerSqFt,
  reinforcementThicknessMm,
  gasketMaterial,
  frameWarrantyYears,
  hardwareWarrantyYears,
  turnaroundDays,
  productTypes,
} = upvc!.data;

const yearsServing = new Date().getFullYear() - foundedYear;
const turnaroundWeeks = Math.round(turnaroundDays / 7);

const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

function getGalleryImage(filename: string): ImageMetadata {
  const entry = Object.entries(galleryImages).find(([path]) => path.endsWith(`/${filename}`));
  if (!entry) throw new Error(`Gallery image not found: ${filename}`);
  return entry[1].default;
}

const workStripImages = [
  "frames.jpeg",
  "closeupshoot.jpeg",
  "door.jpeg",
  "walking path.jpeg",
  "dooor.jpeg",
  "multiple clamp.jpeg",
  "down widnow.jpeg",
  "clampef.jpeg",
].map((name) => ({
  src: getGalleryImage(name),
  alt: "Sun Industries completed work photo",
}));
---

<BaseLayout
  title="Home"
  description="Sun Industries: uPVC windows and doors, steel fabrication, pipe clamps, and laser cutting in Nagercoil."
>
  <!-- SECTION: Landing fold (Hero + rate strip only, everything else starts below it) -->
  <div class="relative isolate flex min-h-[calc(100vh-61px)] flex-col overflow-hidden" data-hero-zoom>
    <Image
      src={getGalleryImage("Hero Image.png")}
      alt=""
      class="absolute inset-0 -z-20 h-full w-full origin-center object-cover will-change-transform"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
    />
    <Hero
      variant="full"
      title="Windows and doors for Nagercoil, with 20 years behind them"
      subtitle="See exactly what's inside your frame: the steel, the gasket, and a 20-year warranty on the frame, not just a price."
      ctaLabel="Book a free site measurement"
      ctaHref="/get-a-quote"
    />

    <!-- SECTION: Rate strip -->
    <div class="pt-8">
      <RateStrip
        ratePerSqFt={ratePerSqFt}
        reinforcementThicknessMm={reinforcementThicknessMm}
        gasketMaterial={gasketMaterial}
        frameWarrantyYears={frameWarrantyYears}
        hardwareWarrantyYears={hardwareWarrantyYears}
        turnaroundDays={turnaroundDays}
      />
    </div>
  </div>

  <script>
    function initHeroZoom() {
      const container = document.querySelector<HTMLElement>("[data-hero-zoom]");
      const img = container?.querySelector<HTMLElement>("img");
      if (!container || !img) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const maxScale = 1.15;
      let ticking = false;

      function update() {
        const rect = container!.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, -rect.top / rect.height));
        img!.style.transform = `scale(${1 + progress * (maxScale - 1)})`;
        ticking = false;
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroZoom);
    } else {
      initHeroZoom();
    }
  </script>

  <!-- SECTION: Three doors -->
  <section class="px-4 md:px-11 lg:px-20 py-8">
    <div class="grid gap-4 sm:grid-cols-3">
      <DoorCard
        title="Windows & Doors"
        description="For your home"
        href="/upvc-windows"
        ctaLabel="Book a free site measurement"
      />
      <DoorCard
        title="Clamps & Wholesale"
        description="For contractors & builders"
        href="/clamps"
        ctaLabel="Ask for a rate list"
      />
      <DoorCard
        title="Laser Cutting"
        description="For workshops"
        href="/laser-cutting"
        ctaLabel="Send a drawing"
      />
    </div>
  </section>

  <!-- SECTION: About -->
  <AboutSection
    imageSrc={getGalleryImage("main door.jpeg")}
    imageAlt="Sun Industries workshop, completed work photo"
    body={`We've been making uPVC windows, steel doors, and clamps from our Nagercoil workshop for over twenty years. We tell you the exact spec, reinforcement thickness and gasket type, not just a price.`}
  />

  <!-- SECTION: Quick stats -->
  <section class="px-4 md:px-11 lg:px-20 py-8">
    <div class="grid gap-4 sm:grid-cols-3">
      <StatCard number={`${yearsServing}+`} label="Years serving Nagercoil" />
      <StatCard number={`${frameWarrantyYears}-yr`} label="Warranty on every frame" />
      <StatCard number={`${turnaroundWeeks} week${turnaroundWeeks === 1 ? "" : "s"}`} label="Order to fitting" />
    </div>
  </section>

  <!-- SECTION: Work strip -->
  <section class="px-4 md:px-11 lg:px-20 py-8">
    <WorkStrip images={workStripImages} />
  </section>

  <!-- SECTION: How it works -->
  <HowItWorksSteps
    turnaroundWeeks={turnaroundWeeks}
    frameWarrantyYears={frameWarrantyYears}
    hardwareWarrantyYears={hardwareWarrantyYears}
    productTypeCount={productTypes.length}
  />

  <!-- SECTION: Recent work -->
  <section class="px-4 md:px-11 lg:px-20 py-12">
    <div class="mx-auto max-w-2xl text-center">
      <PillBadge label="Our work" />
      <h2 class="mt-5 text-3xl font-bold text-ink sm:text-4xl">Recent work</h2>
    </div>
    <div class="mt-10">
      <GalleryGrid limit={9} />
    </div>
    <div class="mt-10 flex justify-center">
      <Button href="/our-work" variant="outline">See all our work</Button>
    </div>
  </section>

  <!-- SECTION: Reviews -->
  <section class="px-4 md:px-11 lg:px-20 py-16 text-center">
    <PillBadge label="Review" />
    <h2 class="mx-auto mt-5 max-w-xl text-3xl font-bold text-ink sm:text-4xl">
      What our clients are saying about us
    </h2>
    <div class="mt-10 flex justify-center">
      <ReviewBadge rating={googleRating} reviewCount={googleReviewCount} showGoogleLink={false} />
    </div>
    <div
      data-testimonial-scroll
      class="-mx-4 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-[calc(50vw-9rem)] pb-4 text-left [scrollbar-width:none] md:-mx-11 lg:-mx-20 [&::-webkit-scrollbar]:hidden"
    >
      {
        demoTestimonials.map((testimonial) => (
          <div class="w-72 shrink-0 snap-center transition-[filter] duration-200 ease-out" data-testimonial-item>
            <TestimonialCard
              quote={testimonial.quote}
              name={testimonial.name}
              location={testimonial.location}
            />
          </div>
        ))
      }
    </div>
  </section>

  <script>
    function initTestimonialScroll() {
      const container = document.querySelector<HTMLElement>("[data-testimonial-scroll]");
      if (!container) return;
      const items = Array.from(container.querySelectorAll<HTMLElement>("[data-testimonial-item]"));

      const target = items[3];
      if (target) {
        container.scrollLeft = target.offsetLeft - container.clientWidth / 2 + target.clientWidth / 2;
      }

      const maxBlurPx = 2.5;
      let ticking = false;

      // On touch devices (no real :hover), the card nearest the carousel's
      // center auto-activates the same dark-fill/light-text state a tap
      // would, so scrolling alone brings each card to life, no tap needed.
      // Devices with a real mouse keep using :hover instead.
      const autoActivateOnCenter = !window.matchMedia("(hover: hover)").matches;
      let activeCard: HTMLElement | null = null;

      function updateBlur() {
        const containerCenter = container!.getBoundingClientRect().left + container!.clientWidth / 2;
        const halfWidth = container!.clientWidth / 2;
        let closestItem: HTMLElement | null = null;
        let closestDistance = Infinity;
        items.forEach((item) => {
          const rect = item.getBoundingClientRect();
          const itemCenter = rect.left + rect.width / 2;
          const distance = Math.min(1, Math.abs(itemCenter - containerCenter) / halfWidth);
          item.style.filter = distance > 0.05 ? `blur(${(distance * maxBlurPx).toFixed(2)}px)` : "none";
          if (distance < closestDistance) {
            closestDistance = distance;
            closestItem = item;
          }
        });

        if (autoActivateOnCenter) {
          const card = closestItem?.querySelector<HTMLElement>(".tilt-card") ?? null;
          if (card !== activeCard) {
            activeCard?.classList.remove("is-touched");
            card?.classList.add("is-touched");
            activeCard = card;
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateBlur);
      }

      updateBlur();
      container.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTestimonialScroll);
    } else {
      initTestimonialScroll();
    }
  </script>

  <!-- SECTION: Service area -->
  <section class="px-4 md:px-11 lg:px-20 py-8">
    <p class="text-ink">Currently serving {serviceArea!.data.confirmedTowns.join(", ")}</p>
    <p class="text-sm text-muted">Ask us if we cover your area</p>
  </section>

</BaseLayout>
