---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/sections/GalleryGrid.astro";
---

<BaseLayout title="Our Work" description="Photos of work completed by Sun Industries.">
  <section class="px-4 md:px-11 lg:px-20 py-12">
    <h1 class="mb-2 text-3xl font-bold text-ink">Our work</h1>
