---
import { getEntry } from "astro:content";
import { Check, Truck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TiltCard from "../components/ui/TiltCard.astro";
import clampPhoto from "../assets/Product page/Clamp for whole sale only.png";

const clamps = await getEntry("specsClamps", "clamps");
const { types, knownDestinations } = clamps!.data;
---

<BaseLayout
  title="Clamps & Wholesale"
  description="Wholesale PVC, uPVC, and SWR pipe clamps from Sun Industries. Already shipping outside the district."
>
  <Hero
    eyebrow="Wholesale only"
    title="Pipe clamps for apartment construction"
    subtitle="PVC, uPVC, and SWR pipe clamps, wholesale supply for plumbers, apartment builders, and contractors."
    ctaLabel="Ask for a rate list"
    ctaHref="/get-a-quote"
    photoSrc={clampPhoto}
    photoAlt="Pipe clamps in graduated sizes"
  />

  <section class="px-4 md:px-11 lg:px-20 py-12">
    <SectionHeading pill="What we supply" title="Clamp types" />
    <div class="grid gap-4 sm:grid-cols-2">
      {
        types.map((type) => (
          <TiltCard>
            <div class="flex items-center gap-2.5 text-sm font-medium text-ink transition-colors duration-500 group-hover:text-surface group-[.is-touched]:text-surface">
              <Check class="size-4 shrink-0 text-sun-text transition-colors duration-500 group-hover:text-surface group-[.is-touched]:text-surface" aria-hidden="true" />
              {type}
            </div>
          </TiltCard>
        ))
      }
    </div>
  </section>

  <section class="px-4 md:px-11 lg:px-20 pb-12">
    <div class="flex gap-4 bg-ink px-6 py-8 text-surface md:px-10">
      <span class="flex size-9 shrink-0 items-center justify-center bg-surface/10 text-sun">
        <Truck class="size-4" aria-hidden="true" />
      </span>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-surface/60">Already shipping outside the district</p>
        <p class="mt-2 text-lg font-medium">
          Regularly supplying wholesale orders to {knownDestinations.join(", ")}.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
